{
  "tasks": {
    "dev": "deno run --watch --allow-env --allow-read --allow-write karabiner_mods.ts --writeToProfile",
    "json": "deno run karabiner_mods.ts > karabiner_mods.json",
    "format": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check karabiner_mods.ts"
  },
  "fmt": {
    "lineWidth": 119,
    "semiColons": false,
    "singleQuote": true
  },
  "imports": {
    "@std/cli": "jsr:@std/cli@^1.0.29",
    "karabiner.ts": "https://deno.land/x/karabinerts@1.37.0/deno.ts"
  }
}
